<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>AutoPost AI — Facebook Automation</title>

  <meta
    name="description"
    content="Premium AI powered Facebook post automation dashboard"
  />

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: Inter, Arial, sans-serif;
    }

    :root {
      --bg: #070b14;
      --card: #0e1422;
      --card2: #121a2b;
      --border: rgba(255,255,255,.09);
      --text: #f8fafc;
      --muted: #94a3b8;
      --primary: #1877f2;
      --primary2: #4f9cff;
      --success: #22c55e;
      --danger: #ef4444;
      --input: #0a101c;
    }

    body {
      min-height: 100vh;
      background:
        radial-gradient(circle at 15% 10%, rgba(24,119,242,.16), transparent 30%),
        radial-gradient(circle at 85% 80%, rgba(79,70,229,.12), transparent 30%),
        var(--bg);
      color: var(--text);
    }

    /* HEADER */

    header {
      height: 76px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 5%;
      border-bottom: 1px solid var(--border);
      background: rgba(7,11,20,.72);
      backdrop-filter: blur(20px);
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 12px;
      font-size: 21px;
      font-weight: 800;
    }

    .logo-icon {
      width: 42px;
      height: 42px;
      display: grid;
      place-items: center;
      border-radius: 13px;
      background: linear-gradient(135deg, #1877f2, #4f46e5);
      box-shadow: 0 8px 25px rgba(24,119,242,.3);
      font-size: 20px;
    }

    .status {
      display: flex;
      align-items: center;
      gap: 8px;
      color: #cbd5e1;
      font-size: 13px;
    }

    .status-dot {
      width: 8px;
      height: 8px;
      background: var(--success);
      border-radius: 50%;
      box-shadow: 0 0 12px var(--success);
    }

    /* LAYOUT */

    .container {
      width: 90%;
      max-width: 1450px;
      margin: auto;
      padding: 42px 0 70px;
    }

    .hero {
      margin-bottom: 32px;
    }

    .hero h1 {
      font-size: clamp(30px, 4vw, 52px);
      line-height: 1.05;
      letter-spacing: -1.8px;
      margin-bottom: 13px;
    }

    .gradient {
      background: linear-gradient(90deg, #fff, #70a8ff);
      -webkit-background-clip: text;
      color: transparent;
    }

    .hero p {
      color: var(--muted);
      max-width: 720px;
      line-height: 1.7;
    }

    .dashboard {
      display: grid;
      grid-template-columns: 1.1fr .9fr;
      gap: 22px;
    }

    .card {
      background: linear-gradient(
        145deg,
        rgba(18,26,43,.95),
        rgba(10,15,27,.95)
      );
      border: 1px solid var(--border);
      border-radius: 22px;
      padding: 25px;
      box-shadow: 0 20px 70px rgba(0,0,0,.22);
    }

    .card-title {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 22px;
    }

    .card-title h2 {
      font-size: 18px;
    }

    .badge {
      padding: 6px 10px;
      border-radius: 30px;
      background: rgba(24,119,242,.12);
      color: #70a8ff;
      font-size: 11px;
      font-weight: 700;
    }

    /* INPUT */

    label {
      display: block;
      color: #cbd5e1;
      font-size: 13px;
      margin-bottom: 9px;
      font-weight: 600;
    }

    textarea,
    select,
    input {
      width: 100%;
      border: 1px solid var(--border);
      background: var(--input);
      color: white;
      border-radius: 14px;
      padding: 15px;
      outline: none;
      transition: .2s;
    }

    textarea {
      min-height: 180px;
      resize: vertical;
      line-height: 1.6;
    }

    textarea:focus,
    select:focus,
    input:focus {
      border-color: rgba(79,156,255,.7);
      box-shadow: 0 0 0 3px rgba(24,119,242,.08);
    }

    .form-group {
      margin-bottom: 18px;
    }

    .row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: